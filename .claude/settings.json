{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/conventions/load-conventions.sh" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-gitnexus.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-gitnexus.sh" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just)", "Bash(just *)", "Bash(./scripts/*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git switch *)", "Bash(git branch *)", "Bash(git pull*)", "Bash(git fetch*)", "Bash(git push *)",
      "Bash(git rev-parse *)", "Bash(git ls-files*)", "Bash(git grep *)", "Bash(git show *)",
      "Bash(gh pr create *)", "Bash(gh pr view *)", "Bash(gh pr checks *)", "Bash(gh pr list*)",
      "Bash(gh pr edit *)", "Bash(gh run view *)", "Bash(gh run list*)",
      "Bash(swift build*)", "Bash(swift test*)", "Bash(swift run *)", "Bash(swift package *)",
      "Bash(swift format *)", "Bash(swiftlint*)", "Bash(xcrun *)", "Bash(xcodebuild -version*)",
      "Bash(ls*)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(grep *)",
      "Bash(find *)", "Bash(sed -n *)", "Bash(awk *)", "Bash(jq *)", "Bash(mkdir -p *)",
      "Edit(apps/macos/**)", "Edit(cards/**)", "Edit(roadmap.md)", "Edit(docs/**)",
      "Edit(conventions/**)", "Edit(scripts/**)", "Edit(README.md)", "Edit(justfile)",
      "Edit(.github/workflows/**)", "Read"
    ],
    "deny": [
      "Bash(gh pr merge *)", "Bash(git push --force*)", "Bash(git push -f *)",
      "Bash(git reset --hard *)", "Bash(git rebase *)", "Bash(git commit --amend*)"
    ]
  }
}
